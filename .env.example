# safeenv environment configuration
# Copy to .env and fill in. NEVER commit .env  (NFR-14)

# ---- Database ----
POSTGRES_USER=safeenv
POSTGRES_PASSWORD=
POSTGRES_DB=safeenv
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Queue ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Public data source API keys (BR-02) ----
# Missing keys do NOT block startup; only that source's ingestion fails.
# The parameter each credential is sent in is declared per source in
# config/sources.yaml (`auth_param`) - it is NOT the same at every source.

# 공공데이터포털 https://www.data.go.kr  (계정당 인증키 1개, 각 API 활용신청 필요)
#   - 한국환경공단_화학물질 정보 조회 서비스   /data/15149420/openapi.do
#   - 한국산업안전보건공단_물질안전보건자료   /data/15157612/openapi.do
# sources.yaml -> auth_param: serviceKey
NCIS_API_KEY=

# 국가법령정보 공동활용 https://open.law.go.kr/LSO/openApi/guideList.do
# NOT an issued key: this is the ID part of the registered e-mail address
# (mail@example.com -> "mail"), sent as the OC parameter. Approval takes 1-2 days.
# sources.yaml -> auth_param: OC
LAW_API_KEY=

# 공공데이터포털 - 화학물질안전원_화학사고정보  /data/15072446/openapi.do
# Same portal as NCIS_API_KEY, so on a single data.go.kr account this is the
# SAME value. They are separate variables only so the two sources can move to
# different providers independently.
# NOTE: the file-data listing (/data/15069200/fileData.do) is a CSV download and
# issues no key at all; 15072446 is the OpenAPI and is what this project calls.
# sources.yaml -> auth_param: ServiceKey  (capital S, per the service spec)
INCIDENT_API_KEY=

# ---- LLM (u2 - not used in u1) ----
ANTHROPIC_API_KEY=

# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=/logs
TZ=Asia/Seoul

# ---- Storage paths (ID-6, ID-8) ----
ORIGINALS_DIR=/data/originals
MODEL_CACHE_DIR=/models

# ---- Embedding (NFR-20, NFR-21) ----
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIM=1024
# 워커 4GiB 한계 기준 실측값. 32 는 피크 3.05GiB 로 OOM 을 유발했다 (8 은 2.43GiB,
# 처리량 차이는 3%). 메모리 한계를 올린 환경에서만 키울 것.
EMBED_BATCH_SIZE=8
EMBED_MAX_SEQ_LENGTH=2048

# ---- Chunking (BR-26~31) ----
MAX_CHUNK_TOKENS=1000
MIN_CHUNK_TOKENS=20
CHUNK_OVERLAP=0
MSDS_MIN_SECTIONS=8

# ---- Retry policy (BR-41) ----
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1,4,16
RETRY_TOTAL_WAIT_CAP=60

# ---- Collection policy (BR-05, BR-06) ----
POLICY_CACHE_TTL=86400
REQUEST_INTERVAL_MS=500
RESPECT_ROBOTS=true

# ---- Worker (BR-52) ----
WORKER_HEARTBEAT_INTERVAL=30
WORKER_STALE_THRESHOLD=120

# ---- Ingestion target (BR-08) ----
INITIAL_SUBSTANCE_TARGET=1000
# BR-08 선정을 위해 물질 목록을 최대 몇 건까지 훑을지. 현재 목록은 7,189건.
SUBSTANCE_SCAN_CAP=10000

# ================================================================
# u2-rag-qa
# ================================================================

# ---- LLM (NFR-21) ----
# 제공자는 어댑터 교체다. u1 이 LLMPort 를 먼저 둔 이유가 이것이다 (DD-6, DD-21).
# gemini | anthropic
LLM_PROVIDER=gemini

# 키는 미설정이어도 앱은 기동한다. 질의 기능만 비활성된다 (BR-02).
# https://aistudio.google.com/apikey 에서 발급 (무료 티어)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# 비워 두면 제공자 기본값을 쓴다 (gemini → gemini-3.1-flash-lite,
# anthropic → claude-opus-5). 제공자를 바꾸면서 모델명을 고정해 두면
# 호출 시점에 "model not found" 로 실패한다.
LLM_MODEL=
# 5xx·타임아웃 1회. 429 는 retry-after 를 따르며 아래 값으로 별도 제한한다.
# refusal 과 4xx 는 재시도하지 않는다 — 반복해도 결과가 같다 (FQ3-14).
LLM_MAX_RETRIES=1
LLM_RATE_LIMIT_RETRIES=2
# 예산이 아니라 **실측 + 여유**에서 온 값이다.
# 실측: 생성 11,582ms (입력 4,597토큰, 6문장) / 검증 2,202~3,588ms.
# 예산(NFR-1 20초)에서 유도해 10초로 잡았더니 동작하던 질의가 실패했다 —
# 타임아웃의 일은 정지를 끊는 것이지 못 지키는 SLO 를 강제하는 것이 아니다.
# 둘이 어긋나면 NFR-1 미달을 기록할 일이지 실패처럼 보이게 할 일이 아니다.
LLM_TIMEOUT_SECONDS=20
# Gemini 는 10초 미만 데드라인을 400 으로 거절한다. 8초로 두면 검증이 전부 실패하고
# BR-87 이 그것을 올바르게 제거해 답변이 통째로 비워진다.
VERIFY_LLM_TIMEOUT_SECONDS=10
# 2단 검증 전용 모델. 무료 티어는 요청 수를 **모델당** 재므로(하루 20, 실측 2026-08-26),
# 검증(문장당 1회, BR-86a)에 다른 모델을 주면 생성과 할당량을 나눠 쓰지 않는다.
# 경량 모델이 타협이 아니라 적합인 이유: SP-6 이 검증자에게 문장 1개·자기 근거·enum 만
# 주고 질문은 보여주지 않는다. 실측 971ms vs 3,268ms.
VERIFY_MODEL=gemini-3.1-flash-lite
# 이보다 긴 retry-after 는 따르지 않는다. 20초 예산(NFR-1) 안에서 34초를 자는 것은
# 재시도가 아니라 같은 실패로 끝나는 정지다 — 실측 64.6초.
MAX_RETRY_AFTER_SECONDS=5

# ---- Retrieval (BR-67, BR-68) ----
KEYWORD_TOP_K=30
VECTOR_TOP_K=30
FUSION_TOP_K=20
FINAL_TOP_K=5
RRF_K=60
QUERY_EMBED_CACHE_SIZE=1024

# ---- Reranker (BR-70, BR-71) ----
# 기본 OFF. app 은 임베딩 모델 적재 시 2GiB 한도의 85% 를 이미 쓴다(u1 실측)므로
# 리랭커는 별도 컨테이너에 둔다. 끄면 reranker 컨테이너 없이도 전부 동작한다.
RERANKER_ENABLED=false
RERANKER_URL=http://reranker:8100
# NFR-2 예산 배분과 같은 값. 예산을 넘긴 리랭커는 이미 SLO 를 깬 것이라 기다리지 않는다.
RERANKER_TIMEOUT_MS=1200
# 실패 후 이 시간 동안은 호출하지 않는다. 소켓 타임아웃이 실패 전체를 묶지 못한다 —
# 컨테이너가 내려간 상태에서 이름 해석만으로 3,355ms 가 걸렸다(타임아웃 1,200ms,
# 검색 예산 2,500ms). BR-71 은 검색을 실패시키지 말라는 것이고, 비용을 물리지도 말라는 것이다.
RERANKER_COOLDOWN_SECONDS=60

# ---- Answering (BR-73, BR-86) ----
# 코사인 유사도 기준이다 (융합 RRF 점수가 아니다 — RRF 는 순위 통계라 좋은 질의와
# 나쁜 질의를 구분하지 못한다). 실코퍼스 측정: 주제 적합 0.66~0.71 / 무관 ~0.42.
# u4 골든셋으로 캘리브레이션하기 전까지 잠정값 (NFR-7).
REFUSAL_SCORE_THRESHOLD=0.50
# 지연이 아니라 격리를 위한 상한이다. 무제한이면 긴 답변 하나가 레이트리밋을
# 소진해 다른 사용자의 질의까지 실패시킨다 (PP-5).
VERIFY_CONCURRENCY=4
QUERY_MAX_CHARS=2000

# C30 엔티티 추출의 LLM 경로. 기본 OFF.
# 규칙이 못 만드는 유일한 출력은 substance_names 인데, 이를 해석하려면
# substance_synonym(BR-65)이 필요하고 u1 은 그 표를 비워 둔다 — u3 를 위한
# 선반영이다(DD-21). 실측(2026-08-26): 규칙만으로 doc_type_hint 3/3 정확,
# 최종 근거 집합 동일, 0.7~46ms vs LLM 경로 116~582ms.
# 물질 마스터가 채워지면 켠다.
ENTITY_LLM_ENABLED=false

# ---- Query log (NFR-14) ----
QUERY_LOG_RETENTION_DAYS=90

# ---- Injection scanning (SP-4) ----
INJECTION_SCAN_ENABLED=true

# ================================================================
# u4 평가 (FR-36~39)
# ================================================================
GOLDEN_SET_PATH=eval/golden-set.yaml
# BR-122 - 심판은 답변 모델과 **달라야** 합니다. 무료 티어 할당량이 모델당이라
# 같은 모델을 쓰면 평가가 답변 할당량을 잠식하고 전체 실행이 끝나지 않습니다.
JUDGE_MODEL=gemini-3.6-flash
JUDGE_LLM_TIMEOUT_SECONDS=60
# 한 번의 --full 실행이 시도할 최대 문항 수. 0 이면 할당량이 막을 때까지.
EVALUATION_BATCH_SIZE=0

# ================================================================
# u5 계정·업로드 (FR-27~33)
# ================================================================
# 기본값이 **없습니다**. 비어 있으면 로그인이 필요한 화면에서 기동이 아니라
# 요청이 실패합니다 (NFR-12, BR-137). 개발용 기본값을 두면 그 값이 배포까지
# 따라가고, 기본값이 있는 비밀키는 비밀이 아닙니다.
JWT_SECRET=
JWT_EXPIRE_HOURS=12
# 운영에서는 true. 로컬 HTTP 개발을 막지 않기 위한 기본값이 false 입니다.
COOKIE_SECURE=false

UPLOADS_DIR=/data/uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PAGES=200
# 사용자당 한도. 전역 감시만 두면 이미 찬 뒤에 알게 되고 누가 채웠는지 모릅니다.
UPLOAD_QUOTA_BYTES=209715200
UPLOAD_QUOTA_DOCUMENTS=50

# 계정 잠금이 아니라 지연입니다. 잠금은 이메일만 아는 사람이 남의 계정을
# 막을 수 있는 도구가 됩니다.
LOGIN_BACKOFF_AFTER=5
LOGIN_BACKOFF_MAX_SECONDS=30

DISCLAIMER_VERSION=1.0.0
